# Set these as deployment secrets; do not commit a real password or secret.
ADMIN_PASSWORD=replace-with-a-long-unique-owner-password
ADMIN_SESSION_SECRET=replace-with-a-random-32-plus-character-secret

# NODE_ENV=production makes the admin cookie HTTPS-only. Your hosting provider
# normally sets this automatically; set it yourself for production deployments.
NODE_ENV=production
